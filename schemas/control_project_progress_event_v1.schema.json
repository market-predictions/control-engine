{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CONTROL_PROJECT_PROGRESS_EVENT_V1",
  "title": "Control Project Progress Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","event_id","project_id","occurred_at","event_class","event_type","points_delta","summary","mapping_rationale","sources"],
  "properties": {
    "version": {"const":"1.1"},
    "event_id": {"type":"string","minLength":1,"maxLength":160,"pattern":"^[A-Za-z0-9._:-]+$"},
    "project_id": {"type":"string","minLength":1,"maxLength":80},
    "occurred_at": {"type":"string","format":"date-time"},
    "event_class": {"enum":["PROCESS","RETAINED_VALUE","CORRECTION"]},
    "event_type": {"enum":["CONTROL_ADOPTION","WORK_EXECUTABLE","IMPLEMENTATION_STARTED","CANDIDATE_PRODUCED","VALIDATION_PASS","ASSURANCE_STARTED","ASSURANCE_PASS","INTEGRATED","LIVE_VERIFIED","OUTCOME_CONFIRMED","BLOCKED","REPAIR","RECONCILIATION","SUPERSEDED","CORRECTION"]},
    "value_class": {"type":["string","null"],"enum":[null,"FOUNDATION","CAPABILITY_VALIDATED","INDEPENDENT_ACCEPTANCE","INTEGRATED_CAPABILITY","OPERATIONAL_OUTCOME"]},
    "points_delta": {"type":"integer","minimum":-4,"maximum":4},
    "capability_lineage_id": {"type":["string","null"],"minLength":1,"maxLength":200},
    "value_scope_ref": {"type":["string","null"],"minLength":1,"maxLength":500},
    "summary": {"type":"string","minLength":1,"maxLength":500},
    "mapping_rationale": {"type":"string","minLength":1,"maxLength":1200},
    "sources": {"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":500,"pattern":"^(github:|runtime:|control:)"}},
    "supersedes_event_id": {"type":["string","null"],"maxLength":160},
    "restores_event_id": {"type":["string","null"],"maxLength":160}
  }
}
