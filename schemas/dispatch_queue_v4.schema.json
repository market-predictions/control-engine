{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/market-predictions/control-engine/schemas/dispatch_queue_v4.schema.json",
  "title": "CONTROL_DISPATCH_QUEUE_V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "principal_manual_relay_count",
    "execution_lock",
    "migration_facts",
    "tasks"
  ],
  "properties": {
    "version": {"const": "4.0"},
    "principal_manual_relay_count": {"const": 0},
    "execution_lock": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/lock"}]},
    "migration_facts": {"type": "array", "items": {"$ref": "#/$defs/migration_fact"}},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "task_id", "started_at", "expires_at"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_sha",
        "candidate_pr_number",
        "candidate_head_branch",
        "expected_base_branch",
        "expected_base_sha"
      ],
      "properties": {
        "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_pr_number": {"type": "integer", "minimum": 1},
        "candidate_head_branch": {"type": "string", "minLength": 1},
        "expected_base_branch": {"type": "string", "minLength": 1},
        "expected_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "review_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_sha", "outcome", "reviewed_at", "reviewer"],
      "properties": {
        "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "outcome": {"enum": ["PASS", "REPAIR_REQUIRED", "BLOCKED"]},
        "reviewed_at": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "findings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "external_review_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_sha", "provider", "request_key", "request_ref", "status"],
      "properties": {
        "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "provider": {"type": "string", "minLength": 1},
        "request_key": {"type": "string", "minLength": 1},
        "request_ref": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "status": {"enum": ["REQUESTING", "PENDING", "PASS", "FAIL", "INDETERMINATE"]},
        "result_ref": {"type": "string", "minLength": 1}
      }
    },
    "migration_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "mission_id", "target_mission_revision", "gap_id", "source_ref"],
      "properties": {
        "fact": {"const": "DONE_CARRY_FORWARD"},
        "mission_id": {"type": "string", "minLength": 1},
        "target_mission_revision": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-r[1-9][0-9]*$"},
        "gap_id": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "mission_id",
        "mission_revision",
        "mission_contract_blob_sha",
        "repository_authority_blob_sha",
        "gap_id",
        "repository",
        "acceptance",
        "integration_policy",
        "review_policy",
        "convergence_required",
        "status",
        "phase",
        "candidate",
        "last_review",
        "external_review",
        "blocker",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "mission_id": {"type": "string", "minLength": 1},
        "mission_revision": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-r[1-9][0-9]*$"},
        "mission_contract_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "repository_authority_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "gap_id": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "integration_policy": {"enum": ["AUTO_AFTER_PASS", "HOLD_AFTER_PASS"]},
        "review_policy": {"enum": ["INTERNAL", "EXTERNAL"]},
        "convergence_required": {"type": "boolean"},
        "status": {"enum": ["QUEUED", "ACTIVE", "BLOCKED", "READY", "DONE", "SUPERSEDED"]},
        "phase": {"oneOf": [{"type": "null"}, {"enum": ["BUILD", "REVIEW", "REPAIR", "INTEGRATE", "CONVERGE"]}]},
        "candidate": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidate"}]},
        "last_review": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/review_record"}]},
        "external_review": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/external_review_record"}]},
        "blocker": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "created_at": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "minLength": 1}
      }
    }
  }
}
