{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control.local/schemas/dispatch_queue_v4.schema.json",
  "title": "CONTROL_DISPATCH_QUEUE_V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "principal_manual_relay_count",
    "execution_lock",
    "migration_facts",
    "tasks"
  ],
  "properties": {
    "version": {"const": "4.0"},
    "principal_manual_relay_count": {"const": 0},
    "execution_lock": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_id", "task_id", "started_at", "expires_at"],
          "properties": {
            "run_id": {"type": "string", "minLength": 1},
            "task_id": {"type": "string", "minLength": 1},
            "started_at": {"type": "string", "minLength": 1},
            "expires_at": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "migration_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_id",
          "fact",
          "mission_id",
          "mission_revision",
          "gap_id",
          "repository",
          "source_task_id",
          "source_result_ref",
          "imported_at",
          "principal_manual_relay_count"
        ],
        "properties": {
          "protocol_id": {"const": "CONTROL_V3_1_MIGRATION_FACT"},
          "fact": {"const": "LEGACY_PROJECT_INTEGRATION_COMPLETED"},
          "mission_id": {"type": "string", "minLength": 1},
          "mission_revision": {"type": "string", "minLength": 1},
          "gap_id": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "minLength": 1},
          "source_task_id": {"type": "string", "minLength": 1},
          "source_result_ref": {"type": "string", "minLength": 1},
          "imported_at": {"type": "string", "minLength": 1},
          "principal_manual_relay_count": {"const": 0}
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "mission_id",
          "mission_revision",
          "mission_contract_blob_sha",
          "repository_authority_blob_sha",
          "gap_id",
          "repository",
          "acceptance",
          "integration_policy",
          "review_policy",
          "convergence_required",
          "status",
          "phase",
          "candidate",
          "last_review",
          "external_review",
          "blocker",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "mission_id": {"type": "string", "minLength": 1},
          "mission_revision": {"type": "string", "minLength": 1},
          "mission_contract_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "repository_authority_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "gap_id": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "minLength": 1},
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "integration_policy": {"enum": ["AUTO_AFTER_PASS", "HOLD_AFTER_PASS"]},
          "review_policy": {"enum": ["INTERNAL", "EXTERNAL"]},
          "convergence_required": {"type": "boolean"},
          "status": {"enum": ["QUEUED", "ACTIVE", "READY", "BLOCKED", "DONE", "SUPERSEDED"]},
          "phase": {
            "oneOf": [
              {"type": "null"},
              {"enum": ["BUILD", "REVIEW", "REPAIR", "INTEGRATE", "CONVERGE"]}
            ]
          },
          "candidate": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["candidate_sha", "candidate_pr_number", "candidate_head_branch", "expected_base_branch", "expected_base_sha"],
                "properties": {
                  "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  "candidate_pr_number": {"type": "integer", "minimum": 1},
                  "candidate_head_branch": {"type": "string", "minLength": 1},
                  "expected_base_branch": {"type": "string", "minLength": 1},
                  "expected_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
                }
              }
            ]
          },
          "last_review": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["candidate_sha", "expected_base_branch", "expected_base_sha", "verdict", "reviewed_at"],
                "properties": {
                  "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  "expected_base_branch": {"type": "string", "minLength": 1},
                  "expected_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  "verdict": {"enum": ["PASS", "REPAIR_REQUIRED", "BLOCKED"]},
                  "reviewed_at": {"type": "string", "minLength": 1}
                }
              }
            ]
          },
          "external_review": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["candidate_sha", "expected_base_branch", "expected_base_sha", "request_key", "status", "request_ref", "evidence_ref"],
                "properties": {
                  "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  "expected_base_branch": {"type": "string", "minLength": 1},
                  "expected_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  "request_key": {"type": "string", "minLength": 1},
                  "status": {"enum": ["REQUESTING", "PENDING", "PASS", "FAIL", "INDETERMINATE"]},
                  "request_ref": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
                  "evidence_ref": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
                }
              }
            ]
          },
          "blocker": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
          "created_at": {"type": "string", "minLength": 1},
          "updated_at": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "QUEUED"}}, "required": ["status"]},
            "then": {"properties": {"phase": {"const": "BUILD"}}}
          },
          {
            "if": {"properties": {"status": {"const": "ACTIVE"}}, "required": ["status"]},
            "then": {"properties": {"phase": {"enum": ["BUILD", "REVIEW", "REPAIR", "INTEGRATE", "CONVERGE"]}}}
          },
          {
            "if": {"properties": {"status": {"enum": ["READY", "BLOCKED", "DONE", "SUPERSEDED"]}}, "required": ["status"]},
            "then": {"properties": {"phase": {"type": "null"}}}
          }
        ]
      }
    }
  }
}