{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/market-predictions/control-engine/schemas/mission_contract_v4.schema.json",
  "title": "MISSION_CONTRACT_V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "mission_id",
    "mission_revision",
    "repository",
    "desired_outcome",
    "gaps",
    "authority_boundaries",
    "principal_manual_relay_count"
  ],
  "properties": {
    "protocol_id": {"const": "MISSION_CONTRACT_V4"},
    "mission_id": {"type": "string", "minLength": 1, "pattern": "^(?!.*--)(?!.*[\\r\\n])[A-Za-z0-9_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?$"},
    "mission_revision": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-r[1-9][0-9]*$"},
    "project_id": {"type": "string", "minLength": 1},
    "effective_at": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "project_governance_ref": {"type": "string", "minLength": 1},
    "desired_outcome": {"type": "string", "minLength": 1},
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "description", "required"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_id",
          "gap_state",
          "depends_on",
          "repository",
          "acceptance",
          "integration_policy",
          "review_policy"
        ],
        "properties": {
          "gap_id": {"type": "string", "minLength": 1, "pattern": "^(?!.*--)(?!.*[\\r\\n])[A-Za-z0-9_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?$"},
          "criterion_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "gap_state": {"enum": ["OPEN", "RETIRED"]},
          "depends_on": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "integration_policy": {"enum": ["AUTO_AFTER_PASS", "HOLD_AFTER_PASS"]},
          "review_policy": {"enum": ["INTERNAL", "EXTERNAL"]},
          "convergence_required": {"type": "boolean"}
        }
      }
    },
    "authority_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "terminal_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "supersedes_revision": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-r[1-9][0-9]*$"}
      ]
    },
    "principal_manual_relay_count": {"const": 0}
  }
}
